linters: linters_with_defaults(
  line_length_linter(140),
  object_length_linter(40),
  # Disable some overly strict linters for documentation-heavy package
  commented_code_linter = NULL,
  cyclocomp_linter = NULL,
  # Keep important style linters
  assignment_linter(),
  commas_linter(),
  infix_spaces_linter(),
  indentation_linter(),
  object_name_linter(),
  object_usage_linter(),
  pipe_continuation_linter(),
  quotes_linter(),
  return_linter(),
  semicolon_linter(),
  seq_linter(),
  spaces_inside_linter(),
  spaces_left_parentheses_linter(),
  T_and_F_symbol_linter(),
  trailing_blank_lines_linter(),
  trailing_whitespace_linter(),
  undesirable_function_linter(),
  undesirable_operator_linter(),
  unneeded_concatenation_linter()
)
exclusions: list(
  # Exclude generated or external files
  "R/zzz.R",
  "data/",
  "tests/testthat.R",
  # Exclude sophisticated build files that may have different conventions
  "ui/build.js",
  "ui/dist/",
  "ui/node_modules/"
)
