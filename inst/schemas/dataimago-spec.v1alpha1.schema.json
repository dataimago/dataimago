                    "rawCategories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": [
                        "papers",
                        "conversations",
                        "data",
                        "references"
                      ]
                    },
                    "wikiMode": {
                      "type": "string",
                      "enum": [
                        "bootstrap",
                        "merge-seeded",
                        "skip"
                      ],
                      "default": "merge-seeded"
                    }
                  },
                  "additionalProperties": false,
                  "default": {}
                }
