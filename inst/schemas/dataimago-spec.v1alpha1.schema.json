              "type": "boolean",
              "default": true
            },
            "mcpTools": {
              "type": "boolean",
              "default": true
            },
            "aiContext": {
              "type": "boolean",
              "default": true
            },
            "apiScaffolding": {
              "type": "boolean",
              "default": true
