.final-message {
  text-align: center;
  padding: 3rem 2rem;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  backdrop-filter: blur(10px);
}

.final-message h3 {
  color: var(--bs-primary);
  margin-bottom: 1rem;
}

/* ========================================
