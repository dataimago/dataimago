            outputReferences: true
          }
        }
      ]
    },
    
    // JavaScript output for runtime tokens
    js: {
      transformGroup: 'js',
      buildPath: '../css/dist/',
      files: [
        {
          destination: 'announce-intents.js',
          format: 'javascript/announce-intents',
