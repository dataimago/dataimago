      <text x="245.5" y="355" class="imago" fill="black">i</text>
      <text x="105" y="360" class="data" fill="black">a</text>
    </mask>
  </defs>

  <!-- Apply the mask to a filled rectangle -->
  <rect class="bg" width="100%" height="100%" rx="40" ry="40" mask="url(#aiMask)"/>
