#!/usr/bin/env node

/**
 * Ethical Enforcement Tool: Contrast Ratio Checker
 * 
 * Validates that all color token pairs meet WCAG accessibility standards
 * as defined in ethical tokens (minimum 4.5:1 for normal text, 7.0:1 for enhanced)
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

/**
 * Convert hex color to RGB
 */
function hexToRgb(hex) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? {
    r: parseInt(result[1], 16),
    g: parseInt(result[2], 16),
    b: parseInt(result[3], 16)
  } : null;
}

/**
 * Calculate relative luminance according to WCAG formula
 */
function relativeLuminance(rgb) {
  const rsRGB = rgb.r / 255;
  const gsRGB = rgb.g / 255;
  const bsRGB = rgb.b / 255;

  const r = rsRGB <= 0.03928 ? rsRGB / 12.92 : Math.pow((rsRGB + 0.055) / 1.055, 2.4);
  const g = gsRGB <= 0.03928 ? gsRGB / 12.92 : Math.pow((gsRGB + 0.055) / 1.055, 2.4);
  const b = bsRGB <= 0.03928 ? bsRGB / 12.92 : Math.pow((bsRGB + 0.055) / 1.055, 2.4);

  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

/**
 * Calculate contrast ratio between two colors
 */
function contrastRatio(color1, color2) {
  const rgb1 = hexToRgb(color1);
  const rgb2 = hexToRgb(color2);
  
  if (!rgb1 || !rgb2) return 0;
  
  const l1 = relativeLuminance(rgb1);
  const l2 = relativeLuminance(rgb2);
  
  const lighter = Math.max(l1, l2);
  const darker = Math.min(l1, l2);
  
  return (lighter + 0.05) / (darker + 0.05);
}

/**
 * Load ethical token thresholds
 */
function loadEthicalThresholds() {
  try {
    const accessibilityPath = path.join(__dirname, '..', 'packages', 'tokens', 'src', 'ethical', 'accessibility.json');
    const content = fs.readFileSync(accessibilityPath, 'utf8');
    const data = JSON.parse(content);
    return data.ethical.a11y.contrast;
  } catch (error) {
    console.error('⚠️ Could not load ethical accessibility tokens:', error.message);
    // Fallback to WCAG standards
    return {
      minimum: { value: 4.5 },
      enhanced: { value: 7.0 },
      'large-text': { value: 3.0 }
    };
  }
}

/**
 * Load semantic color tokens for validation
 */
function loadSemanticTokens() {
  const tokens = {};
  const semanticDir = path.join(__dirname, '..', 'packages', 'tokens', 'src', 'semantic');
  
  try {
    // Load content tokens (text colors)
    const contentPath = path.join(semanticDir, 'content.json');
    const contentTokens = JSON.parse(fs.readFileSync(contentPath, 'utf8'));
    
    // Load surface tokens (background colors)
    const surfacePath = path.join(semanticDir, 'surface.json');
    const surfaceTokens = JSON.parse(fs.readFileSync(surfacePath, 'utf8'));
    
    return { content: contentTokens, surface: surfaceTokens };
  } catch (error) {
    console.error('⚠️ Could not load semantic tokens:', error.message);
    return { content: {}, surface: {} };
  }
}

/**
 * Extract color value, handling both direct hex and rgb() formats
 */
function extractColorValue(colorValue) {
  if (typeof colorValue === 'string') {
    // Handle hex colors
    if (colorValue.startsWith('#')) {
      return colorValue;
    }
    // Handle rgb() format - extract hex equivalent
    const rgbMatch = colorValue.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
    if (rgbMatch) {
      const [, r, g, b] = rgbMatch;
      return `#${parseInt(r).toString(16).padStart(2, '0')}${parseInt(g).toString(16).padStart(2, '0')}${parseInt(b).toString(16).padStart(2, '0')}`;
    }
  }
  return null;
}

/**
 * Main contrast validation function
 */
function validateContrast() {
  console.log('🎨 Contrast Ratio Validation');
  console.log('=============================');
  
  const thresholds = loadEthicalThresholds();
  const tokens = loadSemanticTokens();
  
  const failures = [];
  const validations = [];
  
  // Define critical color pairs that must meet contrast standards
  const colorPairs = [];
  
  // Extract text and surface colors for both light and dark modes
  const textColors = tokens.content?.content?.text || {};
  const surfaceColors = tokens.surface?.surface?.background || {};
  
  // Create validation pairs
  Object.entries(textColors).forEach(([textType, textThemes]) => {
    Object.entries(surfaceColors).forEach(([surfaceType, surfaceThemes]) => {
      ['light', 'dark'].forEach(mode => {
        if (textThemes[mode] && surfaceThemes[mode]) {
          colorPairs.push({
            name: `${textType} text on ${surfaceType} surface (${mode})`,
            foreground: extractColorValue(textThemes[mode]),
            background: extractColorValue(surfaceThemes[mode]),
            threshold: textType === 'primary' ? thresholds.minimum.value : thresholds['large-text'].value
          });
        }
      });
    });
  });
  
  // Validate each color pair
  colorPairs.forEach(pair => {
    if (pair.foreground && pair.background) {
      const ratio = contrastRatio(pair.foreground, pair.background);
      const validation = {
        name: pair.name,
        foreground: pair.foreground,
        background: pair.background,
        ratio: Math.round(ratio * 100) / 100,
        threshold: pair.threshold,
        passes: ratio >= pair.threshold
      };
      
      validations.push(validation);
      
      if (!validation.passes) {
        failures.push(validation);
      }
      
      console.log(`${validation.passes ? '✅' : '❌'} ${validation.name}`);
      console.log(`   ${validation.foreground} on ${validation.background}`);
      console.log(`   Ratio: ${validation.ratio}:1 (requires ${validation.threshold}:1)`);
      console.log('');
    }
  });
  
  // Generate summary
  console.log('Summary');
  console.log('=======');
  console.log(`✅ Passed: ${validations.length - failures.length}`);
  console.log(`❌ Failed: ${failures.length}`);
  console.log(`📊 Total: ${validations.length}`);
  
  if (failures.length > 0) {
    console.log('');
    console.log('⚠️ ETHICAL CONSTRAINT VIOLATIONS DETECTED');
    console.log('The following color combinations do not meet WCAG accessibility standards:');
    console.log('');
    
    failures.forEach(failure => {
      console.log(`• ${failure.name}: ${failure.ratio}:1 (needs ${failure.threshold}:1)`);
    });
    
    console.log('');
    console.log('🔧 ACTION REQUIRED: Update color tokens to meet ethical accessibility standards');
    console.log('   Reference: packages/tokens/src/ethical/accessibility.json');
    
    process.exit(1);
  }
  
  console.log('');
  console.log('🎉 All color combinations meet ethical accessibility standards!');
  console.log('   Ethical constraints successfully enforced.');
  
  return true;
}

// Run validation if called directly
if (import.meta.url === `file://${process.argv[1]}`) {
  validateContrast();
}
