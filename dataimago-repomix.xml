(function() {
  'use strict';

  // Configuration
  const config = {
    useLocalPaths: false, // Set to true for local development
    cdnBase: 'https://cdn.jsdelivr.net/gh/dataimago/dataimago-rpkg@main/dataimago/inst/quarto-assets/',
    localBase: '/assets/',
    transitionDuration: 300,
    debugMode: false
  };

