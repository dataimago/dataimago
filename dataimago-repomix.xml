 * - Proper prefers-reduced-motion support
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

/**
 * Load ethical motion constraints from tokens
 */
function loadMotionConstraints() {
  try {
    const accessibilityPath = path.join(__dirname, '..', 'packages', 'tokens', 'src', 'ethical', 'accessibility.json');
    const content = fs.readFileSync(accessibilityPath, 'utf8');
    const data = JSON.parse(content);
    return data.ethical.dignity.motion;
  } catch (error) {
    console.error('⚠️ Could not load ethical motion tokens:', error.message);
    // Fallback to safe defaults
    return {
      duration: { 
        maximum: { value: '300ms' },
        'reduced-multiplier': { value: 0.001 }
      },
      easing: {
        respectful: { value: 'ease-out' }
      }
    };
  }
}

/**
 * Parse duration strings to milliseconds
 */
function parseDuration(durationStr) {
  const duration = parseFloat(durationStr);
  if (durationStr.includes('ms')) {
    return duration;
  } else if (durationStr.includes('s')) {
    return duration * 1000;
  }
  return 0;
}

/**
 * Extract animation/transition durations from CSS
 */
function extractMotionDurations(cssContent) {
  const violations = [];
  const reducedMotionChecks = [];
  
  // Regex patterns for finding motion properties
  const transitionPattern = /transition(?:-duration)?:\s*([^;]+);/gi;
  const animationPattern = /animation(?:-duration)?:\s*([^;]+);/gi;
  const keyframesPattern = /@keyframes\s+([^{]+)\s*{([^}]+)}/gi;
  const reducedMotionPattern = /@media\s*\(\s*prefers-reduced-motion:\s*reduce\s*\)/gi;
  
  // Check for prefers-reduced-motion support
  const hasReducedMotionSupport = reducedMotionPattern.test(cssContent);
  
  // Find transition durations
  let match;
  while ((match = transitionPattern.exec(cssContent)) !== null) {
    const [fullMatch, value] = match;
    const durations = extractDurationsFromValue(value);
    
    durations.forEach(duration => {
      if (duration.ms > 0) {
        violations.push({
          type: 'transition',
          property: fullMatch.trim(),
          duration: duration.original,
          durationMs: duration.ms,
          line: getLineNumber(cssContent, match.index)
        });
      }
    });
  }
  
  // Find animation durations
  animationPattern.lastIndex = 0; // Reset regex
  while ((match = animationPattern.exec(cssContent)) !== null) {
    const [fullMatch, value] = match;
    const durations = extractDurationsFromValue(value);
    
    durations.forEach(duration => {
      if (duration.ms > 0) {
        violations.push({
          type: 'animation',
          property: fullMatch.trim(),
          duration: duration.original,
          durationMs: duration.ms,
          line: getLineNumber(cssContent, match.index)
        });
      }
    });
  }
  
  return { violations, hasReducedMotionSupport };
}

/**
 * Extract duration values from CSS property value
 */
function extractDurationsFromValue(value) {
  const durations = [];
  // Match duration patterns: 300ms, 0.3s, etc.
  const durationRegex = /(\d*\.?\d+)(ms|s)/g;
  let match;
  
  while ((match = durationRegex.exec(value)) !== null) {
    const [original, number, unit] = match;
    const ms = unit === 's' ? parseFloat(number) * 1000 : parseFloat(number);
    durations.push({ original, ms });
  }
  
  return durations;
}

/**
 * Get line number for a given character index in text
 */
function getLineNumber(text, index) {
  return text.substring(0, index).split('\n').length;
}

/**
 * Recursively find CSS files in a directory
 */
function findCSSFiles(dir, files = []) {
  if (!fs.existsSync(dir)) return files;
  
  try {
    const entries = fs.readdirSync(dir, { withFileTypes: true });
    
    for (const entry of entries) {
      const fullPath = path.join(dir, entry.name);
      
      if (entry.isDirectory()) {
        findCSSFiles(fullPath, files);
      } else if (entry.isFile() && (entry.name.endsWith('.css') || entry.name.endsWith('.scss'))) {
        files.push(fullPath);
      }
    }
  } catch (error) {
    // Directory might not be accessible
  }
  
  return files;
}

/**
 * Find and scan CSS files for motion violations
 */
function scanCSSFiles() {
  const cssFiles = [];
  const distDir = path.join(__dirname, '..', 'dist');
  const packagesDir = path.join(__dirname, '..', 'packages');
  const srcDir = path.join(__dirname, '..', 'src');
  
  // Look for CSS files in common locations
  [distDir, packagesDir, srcDir].forEach(dir => {
    findCSSFiles(dir, cssFiles);
  });
  
  return cssFiles;
}

/**
 * Main motion validation function
 */
function validateMotion() {
  console.log('⚡ Motion Duration Validation');
  console.log('============================');
  
  const constraints = loadMotionConstraints();
  const maxDurationMs = parseDuration(constraints.duration.maximum.value);
  
  console.log(`📏 Maximum allowed duration: ${constraints.duration.maximum.value}`);
  console.log(`🎭 Reduced motion multiplier: ${constraints.duration['reduced-multiplier'].value}`);
  console.log('');
  
  const cssFiles = scanCSSFiles();
  
  if (cssFiles.length === 0) {
    console.log('⚠️ No CSS files found to scan');
    console.log('✅ Motion validation passed (no files to check)');
    return true;
  }
  
  console.log(`📁 Scanning ${cssFiles.length} CSS files...`);
  console.log('');
  
  let totalViolations = 0;
  let filesWithoutReducedMotion = 0;
  const violations = [];
  
  cssFiles.forEach(filePath => {
    const relativePath = path.relative(process.cwd(), filePath);
    
    try {
      const content = fs.readFileSync(filePath, 'utf8');
      const results = extractMotionDurations(content);
      
      // Check for duration violations
      const fileViolations = results.violations.filter(v => v.durationMs > maxDurationMs);
      
      if (fileViolations.length > 0) {
        console.log(`❌ ${relativePath}`);
        fileViolations.forEach(violation => {
          console.log(`   Line ${violation.line}: ${violation.property}`);
          console.log(`   Duration: ${violation.duration} (${violation.durationMs}ms exceeds ${maxDurationMs}ms)`);
          violations.push({ ...violation, file: relativePath });
        });
        console.log('');
        totalViolations += fileViolations.length;
      }
      
      // Check for reduced motion support
      if (results.violations.length > 0 && !results.hasReducedMotionSupport) {
        console.log(`⚠️ ${relativePath}: Contains animations but no prefers-reduced-motion support`);
        filesWithoutReducedMotion++;
      }
      
      // Show passing files
      if (fileViolations.length === 0) {
        const motionCount = results.violations.length;
        if (motionCount > 0) {
          const hasReduced = results.hasReducedMotionSupport ? '✅ reduced-motion' : '❌ no reduced-motion';
          console.log(`✅ ${relativePath} (${motionCount} animations, ${hasReduced})`);
        }
      }
      
    } catch (error) {
      console.log(`⚠️ Could not read ${relativePath}: ${error.message}`);
    }
  });
  
  // Generate summary
  console.log('');
  console.log('Summary');
  console.log('=======');
  console.log(`📁 Files scanned: ${cssFiles.length}`);
  console.log(`⚡ Motion violations: ${totalViolations}`);
  console.log(`🎭 Files missing reduced-motion: ${filesWithoutReducedMotion}`);
  
  if (totalViolations > 0) {
    console.log('');
    console.log('⚠️ ETHICAL DIGNITY VIOLATIONS DETECTED');
    console.log('The following animations exceed maximum duration limits:');
    console.log('');
    
    violations.forEach(violation => {
      console.log(`• ${violation.file}:${violation.line} - ${violation.duration} (max: ${maxDurationMs}ms)`);
    });
    
    console.log('');
    console.log('🔧 ACTION REQUIRED: Reduce animation durations to meet dignity standards');
    console.log('   Long animations can trigger vestibular disorders and motion sensitivity');
    console.log('   Reference: packages/tokens/src/ethical/accessibility.json');
    
    process.exit(1);
  }
  
  if (filesWithoutReducedMotion > 0) {
    console.log('');
    console.log('⚠️ ACCESSIBILITY CONCERN: Some files with animations lack reduced-motion support');
    console.log('   Consider adding @media (prefers-reduced-motion: reduce) rules');
    console.log('');
  }
  
  console.log('');
  console.log('🎉 All animations respect dignity motion constraints!');
  console.log('   Ethical motion standards successfully enforced.');
  
  return true;
}

// Run validation if called directly
if (import.meta.url === `file://${process.argv[1]}`) {
  validateMotion();
}
