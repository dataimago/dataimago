  margin-left: 1rem;
  font-size: 0.8rem;
}

.sidebar-right .table-of-contents .toc-level-3 {
  margin-left: 1.5rem;
  font-size: 0.75rem;
}

/* ========================================
   MAIN CONTENT AREA ADJUSTMENTS
   ======================================== */
.column-page {
  max-width: none;
  padding: 0 2rem;
}

