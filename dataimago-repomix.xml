<file path="ui/src/dataimago-design/tools/bundle-check.mjs">
#!/usr/bin/env node

/**
 * Ethical Enforcement Tool: Bundle Size Monitor
 * 
 * Validates that CSS bundle sizes remain within ethical constraints for:
 * - Low-bandwidth users and devices
 * - Fast loading times for accessibility
 * - Reasonable resource consumption
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

/**
 * Format bytes to human readable format
 */
function formatBytes(bytes) {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

/**
 * Load ethical size constraints from equity tokens
 */
function loadSizeConstraints() {
  try {
    const equityPath = path.join(__dirname, '..', 'packages', 'tokens', 'src', 'ethical', 'equity.json');
    const content = fs.readFileSync(equityPath, 'utf8');
    const data = JSON.parse(content);
    
    // Define reasonable bundle size limits for ethical equity
    return {
      'base-css': {
        warning: 50 * 1024, // 50KB - reasonable for core styles
        error: 100 * 1024,  // 100KB - maximum for accessibility
        description: 'Core CSS bundle should remain lightweight for accessibility'
      },
      'theme-css': {
        warning: 20 * 1024, // 20KB - theme additions should be minimal
        error: 40 * 1024,   // 40KB - maximum for theme switching
        description: 'Theme CSS should be minimal additions'
      },
      'total-css': {
        warning: 150 * 1024, // 150KB - total reasonable size
        error: 250 * 1024,   // 250KB - absolute maximum
        description: 'Total CSS payload for equity and accessibility'
      }
    };
  } catch (error) {
    console.error('⚠️ Could not load ethical equity tokens:', error.message);
    // Fallback to conservative defaults
    return {
      'base-css': { warning: 50 * 1024, error: 100 * 1024 },
      'theme-css': { warning: 20 * 1024, error: 40 * 1024 },
      'total-css': { warning: 150 * 1024, error: 250 * 1024 }
    };
  }
}

/**
 * Analyze bundle size with gzip compression estimate
 */
function analyzeBundleSize(filePath) {
  try {
    const stats = fs.statSync(filePath);
    const content = fs.readFileSync(filePath, 'utf8');
    
    // Simple gzip size estimation (actual gzip would be more accurate)
    // This is a rough approximation - actual gzip is usually 70-80% smaller for CSS
    const estimatedGzipSize = Math.round(stats.size * 0.3); // Conservative estimate
    
    return {
      uncompressed: stats.size,
      estimatedGzip: estimatedGzipSize,
      exists: true,
      content: content.length > 0
    };
  } catch (error) {
    return {
      uncompressed: 0,
      estimatedGzip: 0,
      exists: false,
      content: false,
      error: error.message
    };
  }
}

/**
 * Get all CSS files to check
 */
function getCSSFiles() {
  const distDir = path.join(__dirname, '..', 'dist');
  const packagesCSSDir = path.join(__dirname, '..', 'packages', 'css', 'dist');
  
  const files = [
    // Main distribution files
    { path: path.join(distDir, 'dataimago-base.css'), name: 'dataimago-base.css', category: 'base-css' },
    { path: path.join(distDir, 'dataimago.css'), name: 'dataimago.css', category: 'base-css' },
    { path: path.join(distDir, 'bootstrap-integration.css'), name: 'bootstrap-integration.css', category: 'theme-css' },
    
    // Package distribution files  
    { path: path.join(packagesCSSDir, 'dataimago-base.css'), name: 'packages/css/dataimago-base.css', category: 'base-css' },
    { path: path.join(packagesCSSDir, 'dataimago.css'), name: 'packages/css/dataimago.css', category: 'base-css' },
    { path: path.join(packagesCSSDir, 'bootstrap-integration.css'), name: 'packages/css/bootstrap-integration.css', category: 'theme-css' }
  ];
  
  return files.filter(file => fs.existsSync(file.path));
}

/**
 * Main bundle size validation function
 */
function validateBundleSizes() {
  console.log('📦 Bundle Size Validation');
  console.log('=========================');
  
  const constraints = loadSizeConstraints();
  const files = getCSSFiles();
  
  if (files.length === 0) {
    console.log('⚠️ No CSS bundles found to analyze');
    console.log('   Run npm run build to generate bundles first');
    return false;
  }
  
  console.log(`📁 Analyzing ${files.length} CSS bundles...`);
  console.log('');
  
  let hasWarnings = false;
  let hasErrors = false;
  const results = [];
  const categoryTotals = {};
  
  // Analyze each file
  files.forEach(file => {
    const analysis = analyzeBundleSize(file.path);
    const constraint = constraints[file.category] || constraints['base-css'];
    
    const result = {
      ...file,
      ...analysis,
      constraint,
      status: 'pass'
    };
    
    // Determine status based on size thresholds
    if (analysis.uncompressed >= constraint.error) {
      result.status = 'error';
      hasErrors = true;
    } else if (analysis.uncompressed >= constraint.warning) {
      result.status = 'warning';
      hasWarnings = true;
    }
    
    // Track category totals
    if (!categoryTotals[file.category]) {
      categoryTotals[file.category] = { uncompressed: 0, estimatedGzip: 0 };
    }
    categoryTotals[file.category].uncompressed += analysis.uncompressed;
    categoryTotals[file.category].estimatedGzip += analysis.estimatedGzip;
    
    results.push(result);
    
    // Display result
    const statusIcon = result.status === 'error' ? '❌' : result.status === 'warning' ? '⚠️' : '✅';
    console.log(`${statusIcon} ${file.name}`);
    console.log(`   Size: ${formatBytes(analysis.uncompressed)} (est. ${formatBytes(analysis.estimatedGzip)} gzipped)`);
    console.log(`   Limit: ${formatBytes(constraint.warning)} warning, ${formatBytes(constraint.error)} error`);
    
    if (result.status !== 'pass') {
      console.log(`   ${constraint.description || 'Size limit exceeded'}`);
    }
    console.log('');
  });
  
  // Calculate total size
  const totalSize = results.reduce((sum, r) => sum + r.uncompressed, 0);
  const totalGzipSize = results.reduce((sum, r) => sum + r.estimatedGzip, 0);
  const totalConstraint = constraints['total-css'];
  
  let totalStatus = 'pass';
  if (totalSize >= totalConstraint.error) {
    totalStatus = 'error';
    hasErrors = true;
  } else if (totalSize >= totalConstraint.warning) {
    totalStatus = 'warning';
    hasWarnings = true;
  }
  
  // Display summary
  console.log('Summary');
  console.log('=======');
  Object.entries(categoryTotals).forEach(([category, totals]) => {
    const constraint = constraints[category];
    console.log(`📊 ${category}: ${formatBytes(totals.uncompressed)} (${formatBytes(totals.estimatedGzip)} gzipped)`);
  });
  
  const totalIcon = totalStatus === 'error' ? '❌' : totalStatus === 'warning' ? '⚠️' : '✅';
  console.log(`${totalIcon} Total: ${formatBytes(totalSize)} (est. ${formatBytes(totalGzipSize)} gzipped)`);
  console.log(`   Limit: ${formatBytes(totalConstraint.warning)} warning, ${formatBytes(totalConstraint.error)} error`);
  console.log('');
  
  // Report violations
  if (hasErrors) {
    console.log('⚠️ ETHICAL EQUITY VIOLATIONS DETECTED');
    console.log('Bundle sizes exceed limits that may impact users with:');
    console.log('• Slow internet connections');  
    console.log('• Limited bandwidth or data caps');
    console.log('• Older devices with less memory');
    console.log('');
    
    const errorResults = results.filter(r => r.status === 'error');
    errorResults.forEach(result => {
      const overage = result.uncompressed - result.constraint.error;
      console.log(`• ${result.name}: ${formatBytes(overage)} over limit`);
    });
    
    console.log('');
    console.log('🔧 ACTION REQUIRED: Reduce bundle sizes to meet equity standards');
    console.log('   Consider: CSS purging, compression, code splitting, or removing unused styles');
    
    process.exit(1);
  }
  
  if (hasWarnings) {
    console.log('⚠️ Bundle size warnings - approaching equity limits');
    console.log('   Consider optimizing to improve accessibility for low-bandwidth users');
    console.log('');
  }
  
  console.log('🎉 Bundle sizes meet ethical equity standards!');
  console.log('   CSS bundles remain accessible for all users and devices.');
  
  return true;
}

// Run validation if called directly
if (import.meta.url === `file://${process.argv[1]}`) {
  validateBundleSizes();
}
