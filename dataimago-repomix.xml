/**
 * Bootstrap Integration Layer
 * 
 * This layer maps dataimago semantic tokens to Bootstrap's expected variables.
 * CRITICAL: This prevents variable naming conflicts by creating a clean mapping
 * layer that Bootstrap can consume without theme-dependent conflicts.
 */

/* Import dataimago CSS variables first */
@import '../dist/dataimago.css';

/**
 * Bootstrap Variable Mapping
 * 
 * Strategy: Map our stable semantic variables to Bootstrap's expectations
 * Bootstrap gets consistent variable names, we control the values via our semantic system
 */

:root {
  /* Bootstrap Body/Background Mapping */
  --bs-body-bg: var(--surface-background-page);
  --bs-body-color: var(--content-text-primary);
  
  /* Bootstrap Component Backgrounds */  
  --bs-bg-opacity: 1;
  --bs-card-bg: var(--surface-background-elevated);
  --bs-modal-bg: var(--surface-background-elevated);
  --bs-dropdown-bg: var(--surface-background-elevated);
  
  /* Bootstrap Border System */
  --bs-border-color: var(--surface-border-default);
  --bs-border-color-translucent: var(--surface-border-subtle);
  
