}

.di-inline {
  display: inline;
}

.di-flex {
  display: flex;
}

.di-hidden {
  display: none;
}

.di-justify-center {
  justify-content: center;
}

.di-items-center {
  align-items: center;
}

.di-flex-col {
  flex-direction: column;
}

.di-text-center {
  text-align: center;
}

.di-text-left {
  text-align: left;
}

.di-text-right {
  text-align: right;
}

.di-text-primary {
  color: var(--color-text-primary);
}

.di-text-secondary {
  color: var(--color-text-secondary);
}

.di-text-muted {
  color: var(--color-text-muted);
}

.di-bg-page {
