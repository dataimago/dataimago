}

.navbar-nav .nav-link[href*="github.com"], .navbar-nav .nav-link[href*="bsky.app"] {
  display: inline-flex;
  align-items: center;
}
.navbar-nav .nav-link[href*="github.com"] iconify-icon, .navbar-nav .nav-link[href*="bsky.app"] iconify-icon {
