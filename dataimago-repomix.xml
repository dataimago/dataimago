{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dataimago.ai/schemas/multi-modal-tokens/v1",
  "title": "dataimago Multi-Modal Token Schema",
  "description": "Schema for revolutionary cross-modal design tokens",
  "type": "object",
  "definitions": {
    "tokenValue": {
      "type": "object",
      "properties": {
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "object" }
          ]
        },
        "description": { "type": "string" },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string" }
      },
      "required": ["value"]
    },
    "sensoryVisualToken": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/definitions/tokenValue" },
        "typography": { "$ref": "#/definitions/tokenValue" },
        "spacing": { "$ref": "#/definitions/tokenValue" },
        "elevation": { "$ref": "#/definitions/tokenValue" },
        "opacity": { "$ref": "#/definitions/tokenValue" },
        "blur": { "$ref": "#/definitions/tokenValue" }
      }
    },
    "sensoryAuditoryToken": {
      "type": "object",
      "properties": {
        "earcon": { 
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 },
            "pitch": { "type": "string", "enum": ["ascending", "descending", "steady", "neutral"] },
            "loop": { "type": "boolean" }
          }
        }
      }
    },
    "sensoryHapticToken": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "duration": { "type": "number", "minimum": 0 }
      }
    },
    "temporalToken": {
      "type": "object",
      "properties": {
        "duration": { "$ref": "#/definitions/tokenValue" },
        "easing": { "$ref": "#/definitions/tokenValue" },
        "delay": { "$ref": "#/definitions/tokenValue" },
        "stagger": { "$ref": "#/definitions/tokenValue" }
      }
    },
    "narrativeToken": {
      "type": "object",
      "properties": {
        "tone": { 
          "type": "string",
          "enum": ["friendly", "neutral", "clinical", "urgent", "educational", "empathetic", "supportive", "serious", "joyful"]
        },
        "discourse": { 
          "type": "string",
          "enum": ["affirm", "inform", "question", "warn", "error", "explain", "apologize", "celebrate"]
        },
        "register": {
          "type": "string",
          "enum": ["formal", "informal"]
        },
        "politeness": {
          "type": "string",
          "enum": ["direct", "polite", "hedged"]
        }
      }
    },
    "cognitiveToken": {
      "type": "object",
