const StyleDictionary = require('style-dictionary');

// Custom transform for multi-modal tokens
StyleDictionary.registerTransform({
  name: 'name/multimodal',
  type: 'name',
  transformer: (token) => {
    // Transform nested path to CSS variable name
    // e.g., sensory.visual.color.brand.primary → --sensory-visual-color-brand-primary
    return '--' + token.path.join('-');
  }
});

// Custom format for announce intents (JavaScript module)
StyleDictionary.registerFormat({
  name: 'javascript/announce-intents',
  formatter: ({ dictionary }) => {
    const announces = dictionary.tokens.announce;
    return `export const announceIntents = ${JSON.stringify(announces, null, 2)};`;
  }
});

// Custom format for ARIA mappings
StyleDictionary.registerFormat({
  name: 'json/aria-mappings',
  formatter: ({ dictionary }) => {
    const ariaMappings = {};
    const tokens = dictionary.allTokens;
    
    tokens.forEach(token => {
      if (token.path[0] === 'announce') {
        const intentName = token.path[1];
        if (!ariaMappings[intentName]) {
          ariaMappings[intentName] = {};
        }
        if (token.path.includes('ariaLive') || token.path.includes('ariaRole')) {
          ariaMappings[intentName][token.path[token.path.length - 1]] = token.value;
        }
      }
    });
    
    return JSON.stringify(ariaMappings, null, 2);
  }
});

module.exports = {
  source: ['src/**/*.json'],
  platforms: {
    // CSS output for visual tokens
    css: {
      transformGroup: 'css',
      transforms: ['name/multimodal', 'time/seconds', 'size/px', 'color/css'],
      buildPath: '../css/dist/',
      files: [
        {
          destination: 'dataimago-visual.css',
          format: 'css/variables',
          filter: (token) => token.path[0] === 'sensory' && token.path[1] === 'visual',
          options: {
            selector: ':root',
            outputReferences: true
          }
        },
