/* Site-wide typography now handled in base.scss and shared-components.scss */
/* dataimago Index Page Styles - Specific to index.qmd */
/* ========================================
   SECTION BACKGROUNDS
   ======================================== */
.hero-section {
  min-height: 60vh;
  display: flex;
  align-items: center;
}

/* Smooth scroll behavior */
html {
  scroll-behavior: smooth;
}

/* Ensure full-height slide containers */
.lenis-slide {
  min-height: 60vh;
  position: relative;
  overflow-x: hidden;
}

.hero-slide {
  display: flex;
  align-items: center;
}

.cards-slide {
  padding-top: 4rem;
  padding-bottom: 4rem;
}

/* ========================================
