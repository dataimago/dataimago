      href="https://cdn.jsdelivr.net/gh/dataimago/dataimago-rpkg@v0.1.0/inst/quarto-assets/website-theme.min.css"
      integrity="sha384-[SRI-HASH]"
      crossorigin="anonymous">

<!-- Design Tokens Only -->
