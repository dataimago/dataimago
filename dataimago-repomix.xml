  border-left-color: var(--bs-secondary);
  color: var(--bs-body-color);
}

.sidebar-right .table-of-contents a.active {
  background: color-mix(in srgb, var(--bs-secondary) 15%, transparent);
  border-left-color: var(--bs-secondary);
  color: var(--bs-body-color);
  font-weight: 500;
