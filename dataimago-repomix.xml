    135deg,
    oklch(0.655 0.434 350.6) 0%,
    color-mix(in oklch, oklch(0.655 0.434 350.6) 70%, oklch(0.602 0.284 261.8) 30%) 50%,
    oklch(0.602 0.284 261.8) 100%
  );
}

