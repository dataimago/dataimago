.navbar-nav .dropdown .nav-link:hover {
  color: var(--theme-text-hover);
  background-color: var(--theme-dropdown-hover-bg);
}

.navbar-nav .dropdown .nav-link:hover::after {
  width: calc(100% - 1rem);
}

