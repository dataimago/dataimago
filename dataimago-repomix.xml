<file path="docs/assets/css/landing-page-navigation.css">
/* dataimago Landing Page Navigation - Enhanced Slide Indicators and Progress */

/* ========================================
   ENHANCED SLIDE INDICATORS
   ======================================== */

.dataimago-enhanced-nav {
  position: fixed;
  right: 2rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1rem;
}

.dataimago-enhanced-indicators {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: flex-end;
}

.dataimago-indicator-wrapper {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  transition: all 0.3s ease;
}

.dataimago-indicator-wrapper.active {
  transform: translateX(-5px);
}

.dataimago-enhanced-indicator {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--bs-primary);
  background: transparent;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
}

.dataimago-enhanced-indicator:hover {
  background: var(--bs-primary);
  transform: scale(1.2);
}

.dataimago-enhanced-indicator.active {
  background: var(--bs-primary);
  box-shadow: 0 0 0 4px rgba(var(--bs-primary-rgb), 0.3);
  transform: scale(1.3);
}

.dataimago-indicator-label {
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--bs-secondary-color);
  opacity: 0;
  transform: translateX(10px);
  transition: all 0.3s ease;
  white-space: nowrap;
  background: rgba(var(--bs-body-bg-rgb), 0.9);
  backdrop-filter: blur(10px);
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  border: 1px solid rgba(var(--bs-border-color-rgb), 0.2);
}

.dataimago-indicator-wrapper:hover .dataimago-indicator-label,
.dataimago-indicator-wrapper.active .dataimago-indicator-label {
  opacity: 1;
  transform: translateX(0);
}

/* ========================================
   SKIP CONTROLS
   ======================================== */

.dataimago-skip-controls {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.dataimago-skip-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid var(--bs-primary);
  background: rgba(var(--bs-body-bg-rgb), 0.9);
  backdrop-filter: blur(10px);
  color: var(--bs-primary);
  font-size: 1.2rem;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dataimago-skip-btn:hover {
  background: var(--bs-primary);
  color: var(--bs-body-bg);
  transform: scale(1.1);
}

.dataimago-skip-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ========================================
   PROGRESS BAR
   ======================================== */

.dataimago-progress-container {
  position: fixed;
  left: 2rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.dataimago-progress-bar {
  width: 4px;
  height: 200px;
  background: rgba(var(--bs-border-color-rgb), 0.3);
  border-radius: 2px;
  overflow: hidden;
  position: relative;
}

.dataimago-progress-fill {
  width: 100%;
  height: 0%;
  background: linear-gradient(
    to top,
    var(--bs-primary),
    var(--bs-info)
  );
  border-radius: 2px;
  transition: height 0.3s ease;
  position: absolute;
  bottom: 0;
}

.dataimago-progress-text {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--bs-secondary-color);
  background: rgba(var(--bs-body-bg-rgb), 0.9);
  backdrop-filter: blur(10px);
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  border: 1px solid rgba(var(--bs-border-color-rgb), 0.2);
}

/* ========================================
   MOBILE RESPONSIVE ADAPTATIONS
   ======================================== */

@media (max-width: 768px) {
  .dataimago-enhanced-nav {
    right: 1rem;
  }
  
  .dataimago-indicator-label {
    display: none; /* Hide labels on mobile to save space */
  }
  
  .dataimago-skip-controls {
    position: fixed;
    bottom: 2rem;
    right: 1rem;
    flex-direction: row;
    gap: 1rem;
  }
  
  .dataimago-skip-btn {
    width: 50px;
    height: 50px;
  }
  
  .dataimago-progress-container {
    left: 1rem;
    top: 2rem;
    transform: none;
  }
  
  .dataimago-progress-bar {
    width: 200px;
    height: 4px;
  }
  
  .dataimago-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(
      to right,
      var(--bs-primary),
      var(--bs-info)
    );
  }
  
  .dataimago-progress-text {
    margin-left: 1rem;
  }
}

@media (max-width: 576px) {
  .dataimago-enhanced-indicators {
    gap: 0.5rem;
  }
  
  .dataimago-enhanced-indicator {
    width: 10px;
    height: 10px;
  }
  
  .dataimago-skip-btn {
    width: 45px;
    height: 45px;
    font-size: 1rem;
  }
  
  .dataimago-progress-bar {
    width: 150px;
  }
}

/* ========================================
   TOUCH INTERACTION IMPROVEMENTS
   ======================================== */

@media (hover: none) and (pointer: coarse) {
  .dataimago-enhanced-indicator {
    width: 16px;
    height: 16px;
  }
  
  .dataimago-skip-btn {
    width: 55px;
    height: 55px;
  }
  
  /* Add visual feedback for touch */
  .dataimago-enhanced-indicator:active {
    background: var(--bs-primary);
    transform: scale(0.9);
  }
  
  .dataimago-skip-btn:active {
    transform: scale(0.95);
  }
}

/* ========================================
   ACCESSIBILITY ENHANCEMENTS
   ======================================== */

@media (prefers-reduced-motion: reduce) {
  .dataimago-enhanced-indicator,
  .dataimago-indicator-label,
  .dataimago-skip-btn,
  .dataimago-progress-fill {
    transition: none;
  }
  
  .dataimago-indicator-wrapper {
    transform: none !important;
  }
  
  .dataimago-enhanced-indicator:hover,
  .dataimago-enhanced-indicator.active {
    transform: none;
  }
}

@media (prefers-contrast: high) {
  .dataimago-enhanced-indicator {
    border-width: 3px;
  }
  
  .dataimago-skip-btn {
    border-width: 3px;
  }
  
  .dataimago-indicator-label,
  .dataimago-progress-text {
    background: var(--bs-body-bg);
    border-width: 2px;
  }
}

/* ========================================
   FOCUS STYLES FOR KEYBOARD NAVIGATION
   ======================================== */

.dataimago-enhanced-indicator:focus,
.dataimago-skip-btn:focus {
  outline: 2px solid var(--bs-primary);
  outline-offset: 2px;
}

.dataimago-enhanced-indicator:focus:not(:focus-visible),
.dataimago-skip-btn:focus:not(:focus-visible) {
  outline: none;
}

/* ========================================
   DARK MODE ADAPTATIONS
   ======================================== */

@media (prefers-color-scheme: dark) {
  .dataimago-indicator-label,
  .dataimago-progress-text {
    background: rgba(var(--bs-dark-rgb), 0.9);
    border-color: rgba(255, 255, 255, 0.2);
  }
  
  .dataimago-skip-btn {
    background: rgba(var(--bs-dark-rgb), 0.9);
  }
}

/* ========================================
   ANIMATION KEYFRAMES
   ======================================== */

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(var(--bs-primary-rgb), 0.7);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(var(--bs-primary-rgb), 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(var(--bs-primary-rgb), 0);
  }
}

