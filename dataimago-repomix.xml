  .hero-title {
    font-size: 2rem;
  }
  .section-title {
    font-size: 1.8rem;
  }
  .di-hex-logo {
    width: 200px !important;
  }
  .showcase-logo {
    width: 80px;
    margin: 0.5rem;
  }
}
