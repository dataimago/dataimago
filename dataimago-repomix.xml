});

css += `\n  /* Ethical Constraints */\n`;
const ethicalTokens = tokens.filter(t => !t.themeAware && t.name.includes('ethical'));
ethicalTokens.forEach(token => {
  css += `  --${token.name}: ${token.value}; /* ${token.description || ''} */\n`;
});

css += `}\n\n`;

// Theme-aware tokens
const themeTokens = tokens.filter(token => token.themeAware);

if (themeTokens.length > 0) {
