// dataimago Shared Theme Components
// Common styling that works across light and dark themes using CSS custom properties

// body and base styling with theme-specific overrides
body {
  transition: background-color 0.35s ease;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  line-height: 1.6;
}

// Navbar styling with proper nav-item positioning fix
.navbar {
  background-color: var(--theme-navbar-bg) !important;
  border-color: var(--theme-navbar-bg) !important;
  min-height: 50px;
  transition: all 0.25s ease-in-out;
}

/* Navbar typography - site-wide font hierarchy */
.navbar-title {
  font-family: var(--font-family-brand) !important;
  font-weight: 400;
}

.navbar-brand, .navbar-nav .nav-link {
  font-family: var(--font-family-sans) !important;
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}

// Override Bootstrap's navbar theming to use our CSS custom properties
// This ensures navbar colors follow our theme system regardless of data-bs-theme attribute
.navbar,
.navbar[data-bs-theme="dark"],
.navbar[data-bs-theme="light"] {
  background-color: var(--theme-navbar-bg) !important;
  border-color: var(--theme-navbar-bg) !important;
}

// Navbar text colors that respond to our theme system
.navbar .navbar-brand,
.navbar .navbar-nav .nav-link {
  color: var(--theme-text-secondary) !important;
}

.navbar .navbar-brand:hover,
.navbar .navbar-nav .nav-link:hover,
.navbar .navbar-nav .nav-link:focus {
  color: var(--theme-text-primary) !important;
}

.navbar.shrink {
  background-color: var(--theme-navbar-bg-scrolled);
  min-height: 0;
  padding: 0 0;
  background-size: 32px auto;
  transition-duration: 0.25s;
}

// FIX: Remove the problematic 7px padding that causes dropdown misalignment
nav .nav-item:not(.compact) {
  padding-top: 0px; // Fixed from 7px to 0px for proper dropdown alignment
}

.navbar-title {
  font-family: "Josefin Sans", sans-serif;
  font-weight: 400;
  font-size: 38px;
  padding: 0 0 0 0px;
  height: 48px;
  line-height: 55px;
  background-repeat: no-repeat;
  background-position: 15px center;
  transition: font-size 0.25s ease-in-out;
  color: var(--theme-text-secondary);
}

.navbar-title:hover {
  color: var(--theme-text-hover);
}

.navbar-title.shrink {
  font-size: 32px;
  transition-duration: 0.25s;
}

.navbar-logo {
  background-size: contain;
  background-repeat: no-repeat;
  max-height: 36px;
  transition: max-height 0.35s ease-in-out, transform 0.35s ease-in-out, opacity 0.35s ease-in-out;
  will-change: max-height, transform, opacity;
}

.navbar-logo.shrink {
  max-height: 28px;
}

.navbar-logo.transitioning {
  opacity: 0.8;
  transition: opacity 0.15s ease-in-out;
}

// ===== DROPDOWN MENU STYLES (from POC) =====

/* Ensure the effect works for dropdown menu triggers as well */
.navbar-nav .nav-item.dropdown .nav-link {
  position: relative;
  padding-left: 0.5rem;
  padding-right: 0.5rem;
  color: var(--theme-text-secondary);
}

.navbar-nav .nav-item.dropdown .nav-link::after {
  content: '';
  position: absolute;
  bottom: 5px;
  left: 0.5rem;
  right: 0.5rem;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--theme-text-primary) 0%, var(--theme-text-secondary) 100%);
  transition: width 0.4s ease;
  transform-origin: left;
}

.navbar-nav .nav-item.dropdown .nav-link:hover {
  color: var(--theme-text-primary);
