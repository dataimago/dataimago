    end
    
    subgraph "Validation Rules"
        CR["Text/Background ≥ 4.5:1<br/>Large Text ≥ 3:1<br/>UI Components ≥ 3:1"]
        MR["Duration ≤ 300ms<br/>Respect reduced-motion<br/>Provide pause control"]
        TR["Touch targets ≥ 44px<br/>Spacing ≥ 8px"]
        BR["CSS ≤ 150KB<br/>Gzipped ≤ 50KB"]
    end
    
    subgraph "Output"
        P[Pass ✅<br/>Build continues]
        F[Fail ❌<br/>Build blocked]
    end
    
    T --> CV
    T --> MV
    T --> TV
    T --> BV
    
    CV --> CR
    MV --> MR
    TV --> TR
    BV --> BR
    
    CR --> P
    CR --> F
    MR --> P
    MR --> F
    TR --> P
    TR --> F
    BR --> P
    BR --> F
```

### Enforcement Examples

#### Contrast Enforcement
```javascript
// contrast-check.mjs
const violations = [];
tokens.forEach(token => {
  if (token.type === 'color' && token.role === 'text') {
    const contrast = calculateContrast(token.value, backgroundToken.value);
    if (contrast < ethicalTokens.accessibility.contrast.minimum) {
      violations.push({
        token: token.name,
        contrast: contrast,
        required: ethicalTokens.accessibility.contrast.minimum
      });
    }
  }
});
```

#### Motion Enforcement
```css
/* Automatically enforced in CSS output */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.001ms !important;
    transition-duration: 0.001ms !important;
  }
}

/* Maximum duration enforcement */
.animated {
  transition: all var(--temporal-animation-duration-maximum); /* 300ms max */
}
```

