#!/usr/bin/env node

/**
 * Icon System Builder for dataimago Design System
 * 
 * Generates CSS variables and utility classes for the icon system
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

console.log('🎨 Building icon system CSS...');

// Load all token files (including temporal for references)
const allTokenFiles = [
  // Base tokens for references
  '../src/temporal/animation/durations.json',
  '../src/temporal/latency/loading.json',
  '../src/ethical/accessibility.json',
  '../src/semantic/brand.json',
  // Icon-specific tokens
  '../src/icons/sizing.json',
  '../src/icons/colors.json',
  '../src/icons/states.json',
  '../src/icons/transitions.json'
];

let allTokens = {};
let iconTokens = {};

// Deep merge helper function
function deepMerge(target, source) {
  for (const key in source) {
    if (source[key] && typeof source[key] === 'object' && !Array.isArray(source[key])) {
      if (!target[key]) target[key] = {};
      deepMerge(target[key], source[key]);
    } else {
      target[key] = source[key];
    }
  }
  return target;
}

// Load all tokens for reference resolution
allTokenFiles.forEach(file => {
  const filePath = path.join(__dirname, file);
  if (fs.existsSync(filePath)) {
    const tokens = JSON.parse(fs.readFileSync(filePath, 'utf8'));
    allTokens = deepMerge(allTokens, tokens);
    // Keep icon-specific tokens separate with deep merge
    if (file.includes('/icons/')) {
      iconTokens = deepMerge(iconTokens, tokens);
    }
  }
});

// Resolve token references
function resolveReference(value, tokens) {
  if (typeof value === 'string' && value.startsWith('{') && value.endsWith('}')) {
    const path = value.slice(1, -1).split('.');
    let current = tokens;
    for (const key of path) {
      if (current && current[key]) {
        current = current[key];
      } else {
        // Reference not found, return a fallback
        console.warn(`Warning: Token reference ${value} not found`);
        return value;
      }
    }
    return current.value || current;
  }
  return value;
}

// Convert nested tokens to flat CSS variable names
function flattenTokens(obj, prefix = '') {
  const flattened = [];
  
  for (const [key, value] of Object.entries(obj)) {
    const newPrefix = prefix ? `${prefix}-${key}` : key;
    
    if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
      if (value.value !== undefined) {
        // Single value token - resolve references
        const resolvedValue = resolveReference(value.value, allTokens);
        flattened.push({
          name: newPrefix,
          value: resolvedValue,
          description: value.description
        });
      } else if (value.light !== undefined && value.dark !== undefined) {
        // Theme-aware token - resolve references
        const resolvedLight = resolveReference(value.light, allTokens);
        const resolvedDark = resolveReference(value.dark, allTokens);
        flattened.push({
          name: newPrefix,
          light: resolvedLight,
          dark: resolvedDark,
          description: value.description
        });
      } else {
        // Nested object, recurse
        flattened.push(...flattenTokens(value, newPrefix));
      }
    }
  }
  
  return flattened;
}

// Generate CSS content
function generateIconCSS(tokens) {
  const flattened = flattenTokens(tokens);
  let css = `/**
 * dataimago Icon System
 * Generated from design tokens
 * 
 * This file provides:
 * - CSS variables for icon sizing, colors, and states
 * - Utility classes for common icon patterns
 * - Theme-aware icon styling
 */

/* ============================================
   Icon CSS Variables
   ============================================ */

:root {
`;

  // Generate light theme / default variables
  flattened.forEach(token => {
    if (token.light !== undefined) {
      // Theme-aware token - use light value as default
      css += `  --${token.name}: ${token.light};`;
    } else {
      // Single value token
      css += `  --${token.name}: ${token.value};`;
    }
    
    if (token.description) {
      css += ` /* ${token.description} */`;
    }
    css += '\n';
  });

  css += `}

/* Dark theme overrides */
[data-theme="dark"] {
`;

  // Generate dark theme overrides
  flattened.forEach(token => {
    if (token.dark !== undefined) {
      css += `  --${token.name}: ${token.dark};\n`;
    }
  });

  css += `}

/* ============================================
   Icon Base Styles
   ============================================ */

/* Base icon class */
.icon {
  display: inline-block;
  width: var(--icon-size-md);
  height: var(--icon-size-md);
  vertical-align: middle;
  transition: var(--icon-transition-property-all) var(--icon-transition-duration-fast) var(--icon-transition-easing-default);
