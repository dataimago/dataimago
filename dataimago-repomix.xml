  color: var(--bs-secondary-color);
  font-weight: 500;
  margin-right: 0.5rem;
  font-size: 0.85rem;
}

/* Level 2 headings (H2) */
#toc > ol > li > ol > li > a {
  margin-left: 1rem;
  font-size: 0.85rem;
  padding: 0.375rem 0.75rem;
  border-left-width: 2px;
}

/* Level 3 headings (H3) */
#toc > ol > li > ol > li > ol > li > a {
  margin-left: 2rem;
  font-size: 0.8rem;
  padding: 0.25rem 0.75rem;
  color: var(--bs-secondary-color);
  border-left-width: 1px;
}

