{
  "sensory": {
    "visual": {
      "spacing": {
        "scale": {
          "md": {
            "value": "1rem",
            "description": "Medium spacing"
          }
        }
      }
    }
  }
}

// CSS output
:root {
  --spacing-scale-md: 1rem; /* Medium spacing */
  --spacing-md: var(--spacing-scale-md); /* Compatibility alias */
}
```

