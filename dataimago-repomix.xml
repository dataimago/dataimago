    border-radius: 4px;
    padding: 1rem;
  }
  .mobile-nav-menu.show {
    display: block;
  }
}
@media (max-width: 768px) {
  .column-page {
    padding: 0 1rem;
  }
  .function-section {
    margin-bottom: 2rem;
  }
}
/* ========================================
   ACCESSIBILITY ENHANCEMENTS
   ======================================== */
@media (prefers-reduced-motion: reduce) {
  .sidebar-left .sidebar-link,
  .sidebar-right .table-of-contents a,
