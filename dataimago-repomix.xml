html {
  scroll-behavior: smooth;
}

/* Ensure full-height slide containers */
.lenis-slide {
  min-height: 60vh;
  position: relative;
  overflow-x: hidden;
}

.hero-slide {
  display: flex;
  align-items: center;
}

.cards-slide {
  padding-top: 4rem;
  padding-bottom: 4rem;
}

/* ========================================
