    margin-bottom: 2em;
    
    /* Appropriate font weight for CJK characters */
    font-weight: 400; /* CJK fonts often appear heavier */
  }
  
  /* Arabic/Islamic typography traditions */
  &[data-cultural-context="arabic-islamic"] {
