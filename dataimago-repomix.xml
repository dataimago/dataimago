                    navbarTitle?.classList.remove('shrink');
                    navbarLogo?.classList.remove('shrink');
                    body?.classList.remove('shrink');
                    
                    console.debug('📏 Navbar expanded at scroll position:', scrollY);
                }
            }
        });
        
