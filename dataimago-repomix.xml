        // Single value token
        flattened.push({
          name: newPrefix,
          value: value.value,
          description: value.description
        });
      } else if (value.light !== undefined && value.dark !== undefined) {
        // Theme-aware token
        flattened.push({
          name: newPrefix,
          light: value.light,
          dark: value.dark,
          description: value.description,
          themeAware: true
        });
      } else {
        // Nested group
        flattened.push(...flattenTokens(value, newPrefix));
      }
    }
  }
  
  return flattened;
}

const tokens = flattenTokens(allTokens);

// Generate CSS
let css = `/**
 * dataimago Design System - Conflict-Free Theme Variables
 * 
 * This CSS solves Bootstrap variable naming conflicts by using semantic
 * variable names that don't conflict with Bootstrap's --bs-* namespace.
 * 
 * Generated: ${new Date().toISOString()}
 */

`;

// Non-theme-aware tokens
css += `:root {\n`;
const staticTokens = tokens.filter(token => !token.themeAware);
staticTokens.forEach(token => {
  css += `  --${token.name}: ${token.value}; /* ${token.description || ''} */\n`;
});
css += `}\n\n`;

// Theme-aware tokens
const themeTokens = tokens.filter(token => token.themeAware);

if (themeTokens.length > 0) {
  // Define light and dark variants
  css += `/* Theme variant definitions */\n:root {\n`;
  themeTokens.forEach(token => {
    css += `  --${token.name}-light: ${token.light};\n`;
    css += `  --${token.name}-dark: ${token.dark};\n`;
  });
  css += `}\n\n`;

  // Default theme (light)
  css += `/* Default theme context (light) */\n:root,\n[data-theme="light"] {\n`;
  themeTokens.forEach(token => {
    css += `  --${token.name}: var(--${token.name}-light);\n`;
  });
  css += `}\n\n`;

  // Dark theme
  css += `/* Dark theme context */\n[data-theme="dark"] {\n`;
  themeTokens.forEach(token => {
    css += `  --${token.name}: var(--${token.name}-dark);\n`;
  });
  css += `}\n\n`;

  // Automatic dark mode
  css += `/* Automatic dark mode support */\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme]) {\n`;
  themeTokens.forEach(token => {
    css += `    --${token.name}: var(--${token.name}-dark);\n`;
  });
  css += `  }\n}\n\n`;
}

// High contrast mode
css += `/* High contrast mode (ethical accessibility) */\n[data-theme="high-contrast"] {\n`;
css += `  --surface-border-default: #000000;\n`;
css += `  --surface-border-emphasis: #000000;\n`;
css += `  --content-text-primary: #000000;\n`;
css += `  --content-text-secondary: #000000;\n`;
css += `  filter: contrast(var(--ethical-a11y-contrast-enhanced));\n`;
css += `}\n\n`;

// Reduced motion (ethical dignity)
css += `/* Reduced motion support (ethical dignity) */\n@media (prefers-reduced-motion: reduce) {\n`;
css += `  * {\n`;
css += `    animation-duration: var(--ethical-dignity-motion-duration-reduced-multiplier) !important;\n`;
css += `    transition-duration: var(--ethical-dignity-motion-duration-reduced-multiplier) !important;\n`;
css += `  }\n`;
css += `}\n`;

// Write the CSS file
const outputPath = path.join(__dirname, '../../css/dist/dataimago.css');
fs.writeFileSync(outputPath, css);

console.log(`✅ Generated ${outputPath}`);
console.log(`   ${staticTokens.length} static tokens`);
console.log(`   ${themeTokens.length} theme-aware tokens`);
console.log(`   Conflict-free Bootstrap integration ready`);
````

