  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.di-card:hover {
  box-shadow: var(--shadow-prominent);
  transform: translateY(-2px);
}

.di-card-title {
  margin: 0;
  font-weight: var(--font-weight-semibold);
  font-size: var(--font-size-readable);
