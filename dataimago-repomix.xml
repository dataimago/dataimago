      try {
        const tokens = JSON.parse(fs.readFileSync(filePath, 'utf8'));
        allTokens = { ...allTokens, ...tokens };
        console.log(`    ✓ ${path.basename(file)}`);
      } catch (err) {
        console.log(`    ✗ Error loading ${path.basename(file)}: ${err.message}`);
      }
    } else {
      console.log(`    - Skipping ${path.basename(file)} (not found)`);
    }
  });
});

// Function to flatten multi-modal tokens with compatibility mapping
function flattenMultiModalTokens(obj, prefix = '') {
  const flattened = [];
  
  // Map new grammar to legacy variable names for compatibility
  const compatibilityMap = {
    'sensory-visual-color': 'color',
    'sensory-visual-typography': 'font',
    'sensory-visual-spacing': 'spacing',
    'temporal-animation': 'motion',
    'temporal-feedback': 'feedback',
    'narrative-discourse': 'discourse',
    'cognitive-reading': 'reading'
  };
  
  for (const [key, value] of Object.entries(obj)) {
    let newPrefix = prefix ? `${prefix}-${key}` : key;
    
    // Apply compatibility mapping
    Object.entries(compatibilityMap).forEach(([newPath, oldPath]) => {
      if (newPrefix.startsWith(newPath)) {
        newPrefix = newPrefix.replace(newPath, oldPath);
      }
    });
    
    if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
      if (value.value !== undefined) {
        // Token with value
        flattened.push({
          name: newPrefix,
          value: value.value,
          description: value.description
        });
      } else if (value.light !== undefined && value.dark !== undefined) {
        // Theme-aware token
        flattened.push({
          name: newPrefix,
          light: value.light.value || value.light,
          dark: value.dark.value || value.dark,
          description: value.description,
          themeAware: true
        });
      } else {
        // Nested group
        flattened.push(...flattenMultiModalTokens(value, newPrefix));
      }
    }
  }
  
  return flattened;
}

