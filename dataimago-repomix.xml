/**
 * Bootstrap Integration Layer
 * 
 * This layer maps dataimago semantic tokens to Bootstrap's expected variables.
 * CRITICAL: This prevents variable naming conflicts by creating a clean mapping
 * layer that Bootstrap can consume without theme-dependent conflicts.
 */

/* Import dataimago CSS variables first */
@import '../dist/dataimago.css';

/**
 * Bootstrap Variable Mapping
 * 
 * Strategy: Map our stable semantic variables to Bootstrap's expectations
 * Bootstrap gets consistent variable names, we control the values via our semantic system
 */

:root {
  /* Bootstrap Body/Background Mapping */
  --bs-body-bg: var(--surface-background-page);
  --bs-body-color: var(--content-text-primary);
  
  /* Bootstrap Component Backgrounds */  
  --bs-bg-opacity: 1;
  --bs-card-bg: var(--surface-background-elevated);
  --bs-modal-bg: var(--surface-background-elevated);
  --bs-dropdown-bg: var(--surface-background-elevated);
  
  /* Bootstrap Border System */
  --bs-border-color: var(--surface-border-default);
  --bs-border-color-translucent: var(--surface-border-subtle);
  
  /* Bootstrap Brand Color Mapping */
  --bs-primary: var(--brand-primary);
  --bs-secondary: var(--content-text-secondary);
  --bs-success: var(--state-success);
  --bs-danger: var(--state-error);  
  --bs-warning: var(--state-warning);
  --bs-info: var(--state-info);
  
  /* Bootstrap Link Colors */
  --bs-link-color: var(--content-link-default);
  --bs-link-hover-color: var(--content-link-hover);
  
  /* Bootstrap Focus Ring (Ethical Token Integration) */
  --bs-focus-ring-width: var(--ethical-a11y-focus-ring-width);
  --bs-focus-ring-opacity: 0.25;
  --bs-focus-ring-color: var(--brand-primary);
}

/**
 * Theme Context Switching
 * 
 * Key Innovation: We change our semantic variables, not Bootstrap's variables
 * Bootstrap continues to use the same variable names, but gets different values
 * through our semantic layer
 */

/* Light Theme Context (Default) */
:root,
[data-theme="light"] {
  --surface-background-page: var(--surface-background-page-light);
  --surface-background-elevated: var(--surface-background-elevated-light);
  --surface-background-sunken: var(--surface-background-sunken-light);
  --surface-border-default: var(--surface-border-default-light);
  --surface-border-subtle: var(--surface-border-subtle-light);
  --surface-border-emphasis: var(--surface-border-emphasis-light);
  
  --content-text-primary: var(--content-text-primary-light);
  --content-text-secondary: var(--content-text-secondary-light);
  --content-text-tertiary: var(--content-text-tertiary-light);
  --content-text-inverse: var(--content-text-inverse-light);
  
  --content-link-default: var(--content-link-default-light);
  --content-link-hover: var(--content-link-hover-light);
  --content-link-visited: var(--content-link-visited-light);
  
  --state-success: var(--state-success-light);
  --state-warning: var(--state-warning-light);
  --state-error: var(--state-error-light);
  --state-info: var(--state-info-light);
}

/* Dark Theme Context */
[data-theme="dark"] {
  --surface-background-page: var(--surface-background-page-dark);
  --surface-background-elevated: var(--surface-background-elevated-dark);
  --surface-background-sunken: var(--surface-background-sunken-dark);
  --surface-border-default: var(--surface-border-default-dark);
  --surface-border-subtle: var(--surface-border-subtle-dark);
  --surface-border-emphasis: var(--surface-border-emphasis-dark);
  
  --content-text-primary: var(--content-text-primary-dark);
  --content-text-secondary: var(--content-text-secondary-dark);
  --content-text-tertiary: var(--content-text-tertiary-dark);
  --content-text-inverse: var(--content-text-inverse-dark);
  
  --content-link-default: var(--content-link-default-dark);
  --content-link-hover: var(--content-link-hover-dark);
  --content-link-visited: var(--content-link-visited-dark);
  
  --state-success: var(--state-success-dark);
  --state-warning: var(--state-warning-dark);
  --state-error: var(--state-error-dark);
  --state-info: var(--state-info-dark);
}

/* Automatic Dark Mode Support */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --surface-background-page: var(--surface-background-page-dark);
    --surface-background-elevated: var(--surface-background-elevated-dark);
    --surface-background-sunken: var(--surface-background-sunken-dark);
    --surface-border-default: var(--surface-border-default-dark);
    --surface-border-subtle: var(--surface-border-subtle-dark);
    --surface-border-emphasis: var(--surface-border-emphasis-dark);
    
    --content-text-primary: var(--content-text-primary-dark);
    --content-text-secondary: var(--content-text-secondary-dark);
    --content-text-tertiary: var(--content-text-tertiary-dark);
    --content-text-inverse: var(--content-text-inverse-dark);
    
    --content-link-default: var(--content-link-default-dark);
    --content-link-hover: var(--content-link-hover-dark);
    --content-link-visited: var(--content-link-visited-dark);
    
    --state-success: var(--state-success-dark);
    --state-warning: var(--state-warning-dark);
    --state-error: var(--state-error-dark);
    --state-info: var(--state-info-dark);
  }
}

/**
 * High Contrast Mode
 * 
 * Enhanced accessibility mode with ethical token integration
 */
[data-theme="high-contrast"] {
  --surface-border-default: #000000;
  --surface-border-emphasis: #000000;
  --content-text-primary: #000000;
  --content-text-secondary: #000000;
  
  /* Use enhanced contrast ratios from ethical tokens */
  --bs-focus-ring-width: var(--ethical-a11y-focus-ring-width);
  filter: contrast(1.2);
}

/**
 * Reduced Motion Support (Dignity Integration)
 */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: var(--ethical-dignity-motion-duration-reduced-multiplier) !important;
    transition-duration: var(--ethical-dignity-motion-duration-reduced-multiplier) !important;
  }
}

/**
 * Usage Instructions for Downstream Consumers
 * 
 * CORRECT APPROACH:
 * 1. Import this file BEFORE Bootstrap CSS
 * 2. Use our semantic variables in your custom CSS
 * 3. Let Bootstrap consume its own variables (which now map to ours)
 * 
 * Example Import Order:
 * @import "dataimago-design/packages/css/dist/bootstrap-integration.css";
 * @import "bootstrap/scss/bootstrap";
 * @import "your-custom-styles";
 * 
 * WRONG APPROACH (DON'T DO THIS):
 * - Don't override --bs-* variables directly
 * - Don't duplicate variable definitions
 * - Don't fight Bootstrap's cascade
 */
</file>

