# Exclude CITATION.cff
^CITATION\.cff$

# Exclude CLAUDE.md
^CLAUDE\.md$

# Exclude various file types and CI control files
^.*\.Rproj$
^\.Rproj\.user$
^\.git$
^\.gitignore$
^\.github$
^_pkgdown\.yml$
^docs$
^pkgdown$
^\.travis\.yml$
^appveyor\.yml$
^codecov\.yml$
^\.lintr$

# Exclude sections from original numbered directories to be included in inst/
# 01_Foundations
^inst/dataimago/01_Foundations/ai_conversations
^inst/dataimago/01_Foundations/published_content
# 02_Manifesto
^inst/dataimago/02_Manifesto/ai_conversations
^inst/dataimago/02_Manifesto/notes
# 03_Application_Architecture
^inst/dataimago/03_Application_Architecture/ai_conversations
# 04_dataimago_Content
^inst/dataimago/04_dataimago_Content/Visual_Framework_Assets/notes
^inst/dataimago/04_dataimago_Content/Design_Assets/branding_guide.md$
^inst/dataimago/04_dataimago_Content/Design_Assets/logos/.*\.svg$

# Exclude quarto generated files
^ui/www/_site$
^ui/www/\.quarto$

# Exclude old quarto_website directory if it exists
^quarto_website$

# Exclude Node.js artifacts but include built CSS
^ui/node_modules$
^ui/package-lock\.json$
^ui/pnpm-lock\.yaml$
^ui/\.npmrc$

# Exclude any Node.js artifacts at package root (should not exist)
^package-lock\.json$
^yarn\.lock$
^pnpm-lock\.yaml$
^node_modules$
^\.npmrc$

# Exclude any Quarto extensions at package root (should only be in ui/www/)
^_extensions$

# Exclude README files in R/ and man/ directories (not allowed in R packages)
^R/README\.md$
^man/README\.md$

# Exclude development documentation
^docs/development$

# Exclude empty standard R package directories
^data/?$
^tests/?$
^vignettes/?$

# Exclude empty quarto extension directories (if they exist)  
^ui/www/_extensions/dataimago/ai-native/docs$
^ui/www/_extensions/dataimago/ai-native/examples$
^ui/www/_extensions/dataimago/ai-native/assets/img$

# Exclude large binary files
.*\.pdf$
.*\.key$
